# Copy to `.env` and fill in your key.

# Any OpenAI-compatible endpoint works. The default is Google AI Studio's
# compatibility layer (free tier, no local gateway needed).
# Get a key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite

# Minimum seconds between model requests. Keep it above 60/RPM for your tier
# (Gemini 2.5 Flash Lite: ~15 RPM -> 4s).
LLM_MIN_INTERVAL=4.0

# Optional knobs
# LLM_TIMEOUT=120
# LLM_MAX_TOKENS=8192
# LLM_MAX_ITERATIONS=20

# --- Alternatives ---
# OpenRouter (paid or :free models). LLM_API_KEY wins; OPENROUTER_API_KEY is
# still honoured when the base URL is openrouter.ai.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=cohere/north-mini-code:free

# FreeLLMAPI (self-hosted gateway, requires Docker)
# LLM_BASE_URL=http://localhost:3001/v1
# LLM_API_KEY=freellmapi-...

# Ollama (local models)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
